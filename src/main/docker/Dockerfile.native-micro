####
# Runtime mínimo para executável Quarkus native.
# Pré-requisito: ./mvnw package -Dnative  (binário em target/*-runner)
#
# docker build -f src/main/docker/Dockerfile.native-micro -t mec-backend .
# docker run -i --rm -p 8080:8080 mec-backend
#
# Base ~10MB (UBI 9 micro) + binário nativo (sem UPX — menor RSS em runtime).
###
FROM quay.io/quarkus/ubi9-quarkus-micro-image:2.0
WORKDIR /work/
COPY --chown=1001:root --chmod=0755 target/*-runner /work/application

EXPOSE 8080
USER 1001

ENTRYPOINT ["./application", "-Dquarkus.http.host=0.0.0.0"]
